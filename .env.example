# Copiar a .env.local (desarrollo) y configurar en Vercel → Project Settings → Environment Variables.
# Todas son opcionales: si están vacías, no se carga GA4 ni se agrega la meta de verificación.

# Google Analytics 4 (ID de medición, formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console: valor "content" de la meta google-site-verification
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools: valor "content" de la meta msvalidate.01
NEXT_PUBLIC_BING_VERIFICATION=
